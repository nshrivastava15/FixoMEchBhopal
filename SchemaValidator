package com.iso.parser;

import com.iso.mongo.model.*;
import com.iso.mongo.repo.SchemaRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.w3c.dom.*;

import javax.xml.parsers.DocumentBuilderFactory;
import java.io.File;
import java.util.*;

@Service
@RequiredArgsConstructor
public class XsdParserService {

    private final SchemaRepository repository;

    public SchemaDocument parseXsd(
            String filePath,
            String messageType,
            String version,
            String namespace
    ) throws Exception {

        Document doc = DocumentBuilderFactory
                .newInstance()
                .newDocumentBuilder()
                .parse(new File(filePath));

        NodeList elements =
                doc.getElementsByTagName("xs:element");

        List<FieldNode> fields = new ArrayList<>();

        for (int i = 0; i < elements.getLength(); i++) {

            Element el = (Element) elements.item(i);

            String name = el.getAttribute("name");
            String type = el.getAttribute("type");

            if (name == null || name.isBlank()) continue;

            FieldNode node = FieldNode.builder()
                    .name(name)
                    .path("/" + name)
                    .type(type)
                    .required(!"0".equals(el.getAttribute("minOccurs")))
                    .minOccurs(parseInt(el.getAttribute("minOccurs"), 1))
                    .maxOccurs(parseMax(el.getAttribute("maxOccurs")))
                    .build();

            fields.add(node);
        }

        SchemaDocument schema = SchemaDocument.builder()
                .messageType(messageType)
                .version(version)
                .namespace(namespace)
                .fields(fields)
                .build();

        return repository.save(schema);
    }

    private Integer parseInt(String v, Integer def) {
        try {
            return (v == null || v.isBlank()) ? def : Integer.parseInt(v);
        } catch (Exception e) {
            return def;
        }
    }

    private Integer parseMax(String v) {
        if (v == null || v.isBlank()) return 1;
        if ("unbounded".equals(v)) return Integer.MAX_VALUE;
        return Integer.parseInt(v);
    }
}
