package com.iso.api;

import com.iso.mongo.model.SchemaDocument;
import com.iso.parser.XsdParserService;
import com.iso.service.SchemaService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/schema")
@RequiredArgsConstructor
public class SchemaController {

    private final XsdParserService parserService;
    private final SchemaService schemaService;

    @PostMapping("/load")
    public SchemaDocument load(
            @RequestParam String filePath,
            @RequestParam String messageType,
            @RequestParam String version,
            @RequestParam String namespace
    ) throws Exception {

        return parserService.parseXsd(
                filePath,
                messageType,
                version,
                namespace
        );
    }

    @GetMapping
    public SchemaDocument get(
            @RequestParam String messageType,
            @RequestParam String version
    ) {
        return schemaService
                .getSchema(messageType, version)
                .orElse(null);
    }
}
